# FactShield Environment Variables
# --------------------------------
# MAANG-grade repository standard configuration file.

# 1. PostgreSQL Database Connection
# Replace with your actual DB password
DB_PASSWORD="secretpassword"
DATABASE_URL="postgresql+asyncpg://factshield:${DB_PASSWORD}@localhost:5433/factshield"

# 2. Hugging Face Serverless Inference API Token
# Required for FactShield core operations (Summarise, Explain, Quiz, Evaluate).
# MUST be a valid token with free-tier credits or PRO subscription.
HF_TOKEN="hf_your_huggingface_token_here"

# 3. Application Settings
# DEBUG=True
